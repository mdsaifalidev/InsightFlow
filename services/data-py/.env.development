# Defaults for native development (`pnpm infra:up`, then `pnpm dev`). Real
# environment variables win, so Docker and tests are unaffected.
DATABASE_URL=postgresql+asyncpg://data_svc:data_svc_dev@localhost:5432/insightflow
REDIS_URL=redis://localhost:6379/0
JWKS_URL=http://localhost:4000/api/auth/.well-known/jwks.json
WEB_ORIGIN=http://localhost:3000
S3_ENDPOINT=http://localhost:9000
LLM_PROVIDER=mock
