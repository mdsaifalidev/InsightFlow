# Non-secret defaults for `next dev`. Override locally in .env.development.local.
NEXT_PUBLIC_API_MOCKING=enabled
NEXT_PUBLIC_API_BASE_URL=
# Real auth service (run `pnpm infra:up`, then `pnpm dev` starts web + auth-node).
# Set to "mock" to run the UI with no backend at all.
NEXT_PUBLIC_AUTH_MODE=service
AUTH_SERVICE_URL=http://localhost:4000
# Real data service (services/data-py on :8000 plus its worker). "mock" keeps data on MSW.
NEXT_PUBLIC_DATA_MODE=service
DATA_SERVICE_URL=http://localhost:8000
