{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NEXT_PUBLIC_API_MOCKING",
    "NEXT_PUBLIC_API_BASE_URL",
    "NEXT_PUBLIC_AUTH_MODE",
    "AUTH_SERVICE_URL",
    "NEXT_PUBLIC_DATA_MODE",
    "DATA_SERVICE_URL",
    "CI",
    "DATABASE_URL",
    "MIGRATIONS_DIR",
    "NEXT_DIST_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "dependsOn": [
        "^format:check"
      ]
    }
  }
}
