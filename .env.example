# Copy to .env and adjust. Used by docker-compose.yml (and later by services).
# Web-only, non-secret defaults for `pnpm dev` live in apps/web/.env.development.

# ---- Host ports (change if something on your machine already uses them) ----
GATEWAY_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
AUTH_PORT=4000
DATA_PORT=8000

# ---- PostgreSQL (superuser; only used for bootstrapping) ----
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=insightflow
POSTGRES_DB=insightflow

# Per-service roles (ADR-006): each can only write its own schema.
AUTH_DB_USER=auth_svc
AUTH_DB_PASSWORD=auth_svc_dev
DATA_DB_USER=data_svc
DATA_DB_PASSWORD=data_svc_dev

# ---- Auth service (services/auth-node) ----
# Dev generates RS256 keys automatically (Docker volume auth_keys / .keys).
# Production must set these (pnpm --filter @insightflow/auth-node keys:generate):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# JWT_KEY_ID=

# ---- Data service (services/data-py) ----
# mock is the deterministic template narrator; gemini calls Google AI Studio
# and needs a key (ADR-010). Native dev reads services/data-py/.env.local.
LLM_PROVIDER=mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Object storage (RustFS, S3-compatible; ADR-012) ----
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET_RAW=insightflow-raw
S3_BUCKET_PARQUET=insightflow-parquet

# ---- Web ----
# "enabled" = browser API calls are served by MSW mocks (Phase 2 UI work).
NEXT_PUBLIC_API_MOCKING=enabled
# Empty = same origin (the nginx gateway).
NEXT_PUBLIC_API_BASE_URL=
# "service" = real auth service for /api/auth (data stays mocked); "mock" = all MSW.
NEXT_PUBLIC_AUTH_MODE=service
